@using Microsoft.AspNetCore.Identity
@using AcademiaTennisDAL.Entities
@inject UserManager<ApplicationUser> UserManager

@{
    var usuario = User.Identity?.IsAuthenticated == true
        ? await UserManager.GetUserAsync(User)
        : null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=Edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <meta name="description" content="Academia de Tenis M.M.P. - Clases de tenis para todos los niveles en San José, Costa Rica." />
    <meta name="theme-color" content="#16241a" />
    <title>@ViewData["Title"] - Academia de Tenis M.M.P.</title>

    <link rel="icon" href="~/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 3 (legacy): lo siguen usando módulos que todavía no fueron reworkeados.
         No tocar hasta reworkear esas vistas también. -->
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />

    <!-- Bootstrap 5: el proyecto tenía Bootstrap 3 en CSS pero el JS ya era de Bootstrap 5
         (bootstrap.bundle.min.js 5.3.3, más abajo). Por eso el navbar-toggler, los dropdowns
         y el grid nuevo (col-lg-*, g-4, navbar-expand-lg) no se veían bien. Se carga después
         del v3 para ganar la cascada. -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <link rel="stylesheet" href="~/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/css/tooplate-style.css" />
    <link rel="stylesheet" href="~/css/site.css?v=2" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <!-- REWORK UI: capa nueva de estilos globales (header/nav/footer/base).
         Va al final para ganar la cascada sin tener que borrar nada todavía. -->
    <link rel="stylesheet" href="~/css/rework-layout.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body id="top">

    <!-- Token de seguridad usado por la campana de notificaciones para eliminar por AJAX -->
    <form id="antiForgeryForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    <!-- PRE LOADER -->
    <section class="preloader">
        <div class="spinner">
            <span class="spinner-rotate"></span>
        </div>
    </section>

    <!-- HEADER + NAVBAR -->
    <header class="site-header" id="siteHeader">

        <div class="topbar">
            <div class="container topbar-inner">
                <p class="topbar-tagline">Tu academia de tenis</p>
                <div class="topbar-info">
                    <a href="tel:+50622839369" class="topbar-item"><i class="fa fa-phone"></i> (506) 2283-9369</a>
                    <span class="topbar-item"><i class="fa fa-calendar-plus-o"></i> 6:00 AM - 10:00 PM</span>
                    <a href="mailto:info@tennismmp.com" class="topbar-item"><i class="fa fa-envelope-o"></i> info@tennismmp.com</a>
                </div>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg site-navbar">
            <div class="container">
                <a href="/" class="navbar-brand">
                    <img src="~/images/Logo-mmp.png" alt="Academia de Tenis M.M.P." class="navbar-logo" />
                    <span class="navbar-brand-text">Academia de Tenis <strong>M.M.P.</strong></span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav main-nav-links">
                        <li class="nav-item"><a href="/#top" class="nav-link smoothScroll">Inicio</a></li>
                        <li class="nav-item"><a href="/#nosotros" class="nav-link smoothScroll">Sobre nosotros</a></li>
                        <li class="nav-item"><a href="/#clases" class="nav-link smoothScroll">Clases</a></li>
                        <li class="nav-item"><a asp-controller="Home" asp-action="Tienda" class="nav-link">Tienda</a></li>
                        <li class="nav-item"><a href="/#contacto" class="nav-link smoothScroll">Contacto</a></li>

                        <li class="nav-item dropdown">
                            <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa fa-th-large"></i> Módulos
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Retencion"><i class="fa fa-shield-alt"></i> Retención y Abandono</a></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Campeonatos"><i class="fa fa-trophy"></i> Inscripción a Campeonatos</a></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Gamificacion"><i class="fa fa-gamepad"></i> Gamificación</a></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Geolocalizacion"><i class="fa fa-map-marker-alt"></i> Geolocalización</a></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Dashboard"><i class="fa fa-chart-line"></i> Dashboard y Reportes</a></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Notificaciones"><i class="fa fa-bell"></i> Notificaciones</a></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Feedback"><i class="fa fa-comments"></i> Feedback y Encuestas</a></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Progreso"><i class="fa fa-chart-bar"></i> Progreso Técnico</a></li>
                            </ul>
                        </li>
                    </ul>

                    <div class="navbar-actions">
                        @if (User?.Identity?.IsAuthenticated != true)
                        {
                            <a asp-controller="Home" asp-action="Login" class="btn-nav btn-nav-outline">Iniciar sesión</a>
                            <a asp-controller="Home" asp-action="Registro" class="btn-nav btn-nav-solid">Registrarse</a>
                        }
                        else
                        {
                            @if (User.IsInRole("Administrador"))
                            {
                                <a asp-controller="Home" asp-action="PerfilAdmin" class="nav-panel-link">
                                    <i class="fa fa-user-shield"></i> Mi Panel
                                </a>
                            }
                            else if (User.IsInRole("Profesor"))
                            {
                                <a asp-controller="Home" asp-action="PerfilProfesor" class="nav-panel-link">
                                    <i class="fa fa-chalkboard-teacher"></i> Mi Panel
                                </a>
                            }
                            else if (User.IsInRole("Usuario"))
                            {
                                <a asp-controller="Home" asp-action="PerfilUsuario" class="nav-panel-link">
                                    <i class="fa fa-user"></i> Mi Perfil
                                </a>
                            }

                            <div class="usuario-navbar-actions">

                            @if (User.IsInRole("Usuario") || User.IsInRole("Administrador"))
                                {
                                    <div class="dropdown campana-notificaciones">

                                        <a href="#"
                                           class="campana-toggle"
                                           data-bs-toggle="dropdown"
                                           aria-expanded="false">

                                            <i class="fa fa-bell"></i>

                                            <span id="campanaBadge"
                                                  class="badge-campana"
                                                  style="display:none;">
                                                0
                                            </span>

                                        </a>

                                        <ul class="dropdown-menu dropdown-menu-end campana-dropdown"
                                            id="campanaLista">

                                            <li class="campana-item text-muted text-center">
                                                Cargando...
                                            </li>

                                        </ul>

                                    </div>
                                }

                                <span class="usuario-logueado">
                                    <i class="fa fa-user-circle"></i>
                                    Hola, @usuario?.Nombre
                                </span>

                                <form asp-controller="Auth"
                                      asp-action="Logout"
                                      method="post"
                                      class="logout-navbar">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn-logout-navbar">

                                        <i class="fa fa-sign-out-alt"></i>
                                        Cerrar sesión

                                    </button>

                                </form>

                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-content">
        @RenderBody()
    </div>

    @* Módulo 6 - Asistente Virtual: disponible en todo el sitio *@
    <partial name="_VirtualAssistant" />

    <!-- FOOTER -->
    <footer class="main-footer">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-6">
                    <div class="footer-thumb">
                        <h4>Nuestra Academia</h4>
                        <p class="footer-info-text">
                            Pasión por el tenis en cada entrenamiento. Instalaciones profesionales en el corazón de San José para todos los niveles.
                        </p>
                        <div class="social-container">
                            <a href="https://www.facebook.com/tenismmp" class="social-btn" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                            <a href="#" class="social-btn" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                            <a href="https://wa.me/50683764752" class="social-btn" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
                            <a href="https://x.com/mariomunozp" class="social-btn" aria-label="X"><i class="fab fa-x-twitter"></i></a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="footer-thumb">
                        <h4>Contacto &amp; Horario</h4>
                        <div class="contact-list">
                            <a href="tel:+50622839369" class="contact-item">
                                <div class="icon-circle"><i class="fa fa-phone"></i></div>
                                (506) 2283-9369
                            </a>
                            <a href="https://wa.me/50683764752" class="contact-item">
                                <div class="icon-circle"><i class="fab fa-whatsapp"></i></div>
                                (506) 8376-4752
                            </a>
                            <a href="mailto:info@tenismmp.com" class="contact-item">
                                <div class="icon-circle"><i class="fa fa-envelope"></i></div>
                                info@tenismmp.com
                            </a>
                        </div>
                        <div class="hours-box">
                            <p>
                                Lunes - Sábado: <span>6:00 AM - 11:00 PM</span><br />
                                Domingo: <span>6:00 AM - 12:00 MD</span>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-12">
                    <div class="footer-thumb">
                        <h4>Ubicación</h4>
                        <div class="map-wrapper">
                            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3930.1906940445497!2d-84.06010078470023!3d9.918070577159687!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8fa0e39fc33e177b%3A0x51f513e80d90af60!2sAcademia+de+Tenis+M.M.P.!5e0!3m2!1ses-419!2scr!4v1446309209705"
                                    height="200" style="border:0; width:100%;" allowfullscreen="" loading="lazy"></iframe>
                        </div>
                        <p class="mt-2 small footer-location">
                            <i class="fa fa-map-marker-alt"></i> San José, Costa Rica.
                        </p>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p class="copyright">© 2026 <strong>Tenis M.M.P</strong> | Academia de Tenis.</p>
                <a href="#top" class="smoothScroll btn-scroll-top" aria-label="Volver arriba">
                    <i class="fa fa-chevron-up"></i>
                </a>
            </div>
        </div>
    </footer>

    <script src="~/js/jquery.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/custom.js"></script>
    <script src="~/js/NavbarCampana.js"
        asp-append-version="true"></script>
    <script src="~/js/VirtualAssistant.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
            // Sombra en el navbar al hacer scroll (rework UI)
            (function() {
                var header = document.getElementById('siteHeader');
                if (!header) return;
                var onScroll = function() {
                    if (window.scrollY > 30) header.classList.add('is-scrolled');
                    else header.classList.remove('is-scrolled');
                    else header.classList.remove('is-scrolled');
                };
                window.addEventListener('scroll', onScroll, { passive: true });
                onScroll();
            })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>