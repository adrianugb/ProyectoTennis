@using Microsoft.AspNetCore.Identity
@using AcademiaTennisDAL.Entities
@inject UserManager<ApplicationUser> UserManager

@{
    var usuario = User.Identity?.IsAuthenticated == true
        ? await UserManager.GetUserAsync(User)
        : null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=Edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <title>@ViewData["Title"] - ProyectoGrupalTennis</title>

    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/css/animate.css" />
    <link rel="stylesheet" href="~/css/owl.carousel.css" />
    <link rel="stylesheet" href="~/css/owl.theme.default.min.css" />
    <link rel="stylesheet" href="~/css/tooplate-style.css" />
    <link rel="stylesheet" href="~/css/site.css?v=2" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    
</head>
<body id="top" data-spy="scroll" data-target=".navbar-collapse" data-offset="50">

    <!-- Token de seguridad usado por la campana de notificaciones para eliminar por AJAX -->
    <form id="antiForgeryForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    <!-- PRE LOADER -->
    <section class="preloader">
        <div class="spinner">
            <span class="spinner-rotate"></span>
        </div>
    </section>

    <!-- HEADER -->
    <header>
        <div class="container">
            <div class="row">
                <div class="col-md-4 col-sm-5">
                    <p>Tu academia de tennis</p>
                </div>
                <div class="col-md-8 col-sm-7 text-align-right">
                    <span class="phone-icon"><i class="fa fa-phone"></i> 010-060-0160</span>
                    <span class="date-icon"><i class="fa fa-calendar-plus-o"></i> 6:00 AM - 10:00 PM</span>
                    <span class="email-icon"><i class="fa fa-envelope-o"></i> <a href="#">info@tennismmp.com</a></span>
                </div>
            </div>
        </div>
    </header>

    <!-- MENU -->
    <section class="navbar navbar-default navbar-static-top" role="navigation">
        <div class="container">
            <div class="navbar-header">
                <button class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon icon-bar"></span>
                    <span class="icon icon-bar"></span>
                    <span class="icon icon-bar"></span>
                </button>
                <a href="/" class="navbar-brand"><i class="fa fa-h-square"></i>cademia de Tennis</a>
            </div>
            <div class="collapse navbar-collapse">
                <ul class="nav navbar-nav navbar-right">
                    <li><a href="/#top" class="smoothScroll">Inicio</a></li>
                    <li><a href="/#about" class="smoothScroll">Sobre nosotros</a></li>
                    <li><a href="/#team" class="smoothScroll">Clases</a></li>
                    <li><a href="/#news" class="smoothScroll">Noticias</a></li>
                    <li><a asp-controller="Home" asp-action="Tienda">Tienda</a></li>
                    <li><a href="/#google-map" class="smoothScroll">Contacto</a></li>
                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle nav-link text-dark" data-bs-toggle="dropdown">
                            <i class="fa fa-th-large"></i> Módulos <span class="caret"></span>
                        </a>
                        <ul class="dropdown-menu">
                            <li><a asp-controller="Home" asp-action="Retencion"><i class="fa fa-shield-alt"></i> Retención y Abandono</a></li>
                            <li><a asp-controller="Home" asp-action="Campeonatos"><i class="fa fa-trophy"></i> Inscripción a Campeonatos</a></li>
                            <li><a asp-controller="Home" asp-action="Gamificacion"><i class="fa fa-gamepad"></i> Gamificación</a></li>
                            <li><a asp-controller="Home" asp-action="Geolocalizacion"><i class="fa fa-map-marker-alt"></i> Geolocalización</a></li>
                            <li><a asp-controller="Home" asp-action="Dashboard"><i class="fa fa-chart-line"></i> Dashboard y Reportes</a></li>
                            <li><a asp-controller="Home" asp-action="Notificaciones"><i class="fa fa-bell"></i> Notificaciones</a></li>
                            <li><a asp-controller="Home" asp-action="Feedback"><i class="fa fa-comments"></i> Feedback y Encuestas</a></li>
                            <li><a asp-controller="Home" asp-action="Progreso"><i class="fa fa-chart-bar"></i> Progreso Técnico</a></li>
                        </ul>
                    </li>

                    @if (User?.Identity?.IsAuthenticated != true)
                    {
                        <li class="appointment-btn">
                            <a asp-controller="Home" asp-action="Login">Iniciar Sesión</a>
                        </li>
                        <li class="appointment-btn">
                            <a asp-controller="Home" asp-action="Registro">Registrarse</a>
                        </li>
                    }

                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        @* Link a perfil según rol *@
                        @if (User.IsInRole("Administrador"))
                        {
                            <li>
                                <a asp-controller="Home" asp-action="PerfilAdmin"
                                   style="color:#a5c422; font-weight:600;">
                                    <i class="fa fa-user-shield me-1"></i> Mi Panel
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("Profesor"))
                        {
                            <li>
                                <a asp-controller="Home" asp-action="PerfilProfesor"
                                   style="color:#a5c422; font-weight:600;">
                                    <i class="fa fa-chalkboard-teacher me-1"></i> Mi Panel
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("Usuario"))
                        {
                            <li>
                                <a asp-controller="Home" asp-action="PerfilUsuario"
                                   style="color:#a5c422; font-weight:600;">
                                    <i class="fa fa-user me-1"></i> Mi Perfil
                                </a>
                            </li>
                        }

                        @* Campana de notificaciones - solo para alumnos (USER-09-009) *@
                        @if (User.IsInRole("Usuario"))
                        {
                            <li class="dropdown campana-notificaciones">
                                <a href="#" class="dropdown-toggle nav-link text-dark" data-bs-toggle="dropdown">
                                    <i class="fa fa-bell"></i>
                                    <span id="campanaBadge" class="badge-campana" style="display:none;">0</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end campana-dropdown" id="campanaLista">
                                    <li class="campana-item text-muted text-center">Cargando...</li>
                                </ul>
                            </li>
                        }
                        <li>
                            <span class="usuario-logueado">
                                <i class="fa fa-user-circle"></i>
                                Hola, @usuario?.Nombre
                            </span>
                        </li>

                        <li class="logout-navbar">
                            <form asp-controller="Auth"
                                  asp-action="Logout"
                                  method="post">
                                <button type="submit" class="btn-logout-navbar">
                                    <i class="fa fa-sign-out-alt"></i>
                                    Cerras sesión
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </section>

    <div class="main-content">
        @RenderBody()
    </div>

    @* Módulo 6 - Asistente Virtual: disponible en todo el sitio *@
    <partial name="_VirtualAssistant" />

    <!-- FOOTER -->
    <footer class="main-footer">
        <div class="container">
            <div class="row">
                <div class="col-md-4 col-sm-6">
                    <div class="footer-thumb">
                        <h4>Nuestra Academia</h4>
                        <p class="footer-info-text">
                            Pasión por el tennis en cada entrenamiento. Instalaciones profesionales en el corazón de San José para todos los niveles.
                        </p>
                        <div class="social-container">
                            <a href="https://www.facebook.com/tenismmp" class="social-btn"><i class="fab fa-facebook-f"></i></a>
                            <a href="#" class="social-btn"><i class="fab fa-instagram"></i></a>
                            <a href="https://wa.me/50683764752" class="social-btn"><i class="fab fa-whatsapp"></i></a>
                            <a href="https://x.com/mariomunozp" class="social-btn"><i class="fab fa-x-twitter"></i></a>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 col-sm-6">
                    <div class="footer-thumb">
                        <h4>Contacto & Horario</h4>
                        <div class="contact-list">
                            <a href="tel:+50622839369" class="contact-item">
                                <div class="icon-circle"><i class="fa fa-phone"></i></div>
                                (506) 2283-9369
                            </a>
                            <a href="https://wa.me/50683764752" class="contact-item">
                                <div class="icon-circle"><i class="fab fa-whatsapp"></i></div>
                                (506) 8376-4752
                            </a>
                            <a href="mailto:info@tenismmp.com" class="contact-item">
                                <div class="icon-circle"><i class="fa fa-envelope"></i></div>
                                info@tenismmp.com
                            </a>
                        </div>
                        <div class="hours-box">
                            <p>
                                Lunes - Sábado: <span>6:00 AM - 11:00 PM</span><br />
                                Domingo: <span>6:00 AM - 12:00 MD</span>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 col-sm-12">
                    <div class="footer-thumb">
                        <h4>Ubicación</h4>
                        <div class="map-wrapper">
                            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3930.1906940445497!2d-84.06010078470023!3d9.918070577159687!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8fa0e39fc33e177b%3A0x51f513e80d90af60!2sAcademia+de+Tenis+M.M.P.!5e0!3m2!1ses-419!2scr!4v1446309209705"
                                    width="100%" height="200" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                        </div>
                        <p class="mt-2 small" style="color: #666; text-align: left;">
                            <br /><i class="fa fa-map-marker-alt" style="color: var(--primary-color);"></i> San José, Costa Rica.
                        </p>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p class="copyright">© 2026 <strong>Tenis M.M.P</strong> | Academia de Tenis.</p>
                <a href="#top" class="smoothScroll btn-scroll-top">
                    <i class="fa fa-chevron-up"></i>
                </a>
            </div>
        </div>
    </footer>

    <script src="~/js/jquery.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/jquery.sticky.js"></script>
    <script src="~/js/jquery.stellar.min.js"></script>
    <script src="~/js/wow.min.js"></script>
    <script src="~/js/smoothscroll.js"></script>
    <script src="~/js/owl.carousel.min.js"></script>
    <script src="~/js/custom.js"></script>
    <script src="~/js/NavbarCampana.js"></script>
    <script src="~/js/VirtualAssistant.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
