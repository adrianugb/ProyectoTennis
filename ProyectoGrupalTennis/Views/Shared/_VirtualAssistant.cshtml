            </div>
        </section>

        <footer class="va-footer">
            <input type="text" id="vaInput" class="va-input" placeholder="Escribe tu mensaje..." maxlength="500" />
            <button class="va-send" id="vaSend" aria-label="Enviar mensaje"><i class="fa fa-paper-plane"></i></button>
        </footer>
    </aside>
</div>

