@model AcademiaTennisDAL.Entities.SolicitudCurso

@{
    ViewData["Title"] = "Detalle de solicitud";
}

<link rel="stylesheet"
      href="~/css/perfiles.css"
      asp-append-version="true" />

<section class="perfil-page compact">

    <div class="container-fluid px-4">

        <div class="perfil-container"
             style="max-width:1400px; margin:0 auto;">

            <div class="perfil-header">

                <div>
                    <h1 class="perfil-title">
                        Detalle de solicitud
                    </h1>

                    <p class="perfil-subtitle">
                        Consulta la información de la solicitud y la propuesta preparada por la academia.
                    </p>
                </div>

                <div class="perfil-badge">
                    SOL-@Model.IdSolicitudCurso.ToString("D4")
                </div>

            </div>

            @if (TempData["Success"] != null &&
       TempData["WhatsappUrl"] == null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            @if (TempData["AdvertenciaCorreo"] != null)
            {
                <div class="alert alert-warning">
                    @TempData["AdvertenciaCorreo"]
                </div>
            }

            @if (TempData["AdvertenciaWhatsapp"] != null)
            {
                <div class="alert alert-warning">
                    @TempData["AdvertenciaWhatsapp"]
                </div>
            }

            @if (TempData["WhatsappUrl"] != null)
            {
                <div class="alert alert-success mt-3">

                    <p class="mb-2">
                        La propuesta fue enviada correctamente. También puedes notificar al alumno por WhatsApp.
                    </p>

                    <a href="@TempData["WhatsappUrl"]"
                       target="_blank"
                       class="btn btn-success">

                        <i class="fa fa-whatsapp me-1"></i>
                        Notificar por WhatsApp

                    </a>

                </div>
            }

            <div class="perfil-table-block">

                <p>
                    <strong>Alumno:</strong>
                    @Model.Alumno.Nombre @Model.Alumno.Apellido
                </p>

                <p>
                    <strong>Clase o paquete:</strong>
                    @Model.NombreCurso
                </p>

                <p>
                    <strong>Tipo de clase:</strong>
                    @Model.Modalidad
                </p>

                <p>
                    <strong>Nivel:</strong>
                    @Model.Nivel
                </p>

                <p>
                    <strong>Precio:</strong>
                    $@Model.PrecioSolicitado?.ToString("N2")
                </p>

                <div class="mb-3">
                    <strong>Estado:</strong>

                    <span class="perfil-badge ms-2">
                        @Model.Estado
                    </span>
                </div>

                <p>
                    <strong>Requiere equipo:</strong>
                    @(Model.RequiereEquipo ? "Sí" : "No")
                </p>

                <p>
                    <strong>Clase a domicilio:</strong>
                    @(Model.EsADomicilio ? "Sí" : "No")
                </p>

                @if (Model.EsADomicilio &&
                     !string.IsNullOrWhiteSpace(Model.DireccionDomicilio))
                {
                    <p>
                        <strong>Dirección:</strong>
                        @Model.DireccionDomicilio
                    </p>
                }

                <p>
                    <strong>Comentarios:</strong>
                    @(string.IsNullOrWhiteSpace(Model.Comentarios)
                        ? "Sin comentarios"
                        : Model.Comentarios)
                </p>

                <h2 class="perfil-table-title mt-4">
                    Disponibilidad del alumno
                </h2>

                @if (Model.Disponibilidades.Any())
                {
                    <ul>
                        @foreach (var disponibilidad in Model.Disponibilidades)
                        {
                            <li>
                                @disponibilidad.DiaSemana:
                                @disponibilidad.HoraDesde.ToString(@"hh\:mm")
                                -
                                @disponibilidad.HoraHasta.ToString(@"hh\:mm")
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p>
                        No hay disponibilidades registradas.
                    </p>
                }

                @if (Model.FechaPropuesta.HasValue ||
     Model.HoraInicioPropuesta.HasValue ||
     Model.HoraFinPropuesta.HasValue ||
     Model.IdProfesorPropuesto.HasValue ||
     Model.IdCanchaPropuesta.HasValue)
                {
                    <div class="perfil-table-block mt-4">

                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                            <div>
                                <h2 class="perfil-table-title mb-1">
                                    Propuesta de la academia
                                </h2>

                                <p class="text-muted mb-0">
                                    Horario, profesor y cancha propuestos para esta solicitud.
                                </p>
                            </div>

                            <span class="perfil-badge">
                                @Model.Estado
                            </span>

                        </div>

                        <div class="row g-3 mt-2">

                            <div class="col-md-4">
                                <strong>Fecha propuesta</strong>

                                <p class="mb-0">
                                    @(Model.FechaPropuesta.HasValue
                                        ? Model.FechaPropuesta.Value.ToString("dd/MM/yyyy")
                                        : "Por confirmar")
                                </p>
                            </div>

                            <div class="col-md-4">
                                <strong>Horario propuesto</strong>

                                <p class="mb-0">
                                    @(Model.HoraInicioPropuesta.HasValue
                                        ? Model.HoraInicioPropuesta.Value.ToString(@"hh\:mm")
                                        : "Por confirmar")
                                    -
                                    @(Model.HoraFinPropuesta.HasValue
                                        ? Model.HoraFinPropuesta.Value.ToString(@"hh\:mm")
                                        : "Por confirmar")
                                </p>
                            </div>

                            <div class="col-md-4">
                                <strong>Profesor</strong>

                                <p class="mb-0">
                                    @(Model.ProfesorPropuesto != null
                                        ? $"{Model.ProfesorPropuesto.Nombre} {Model.ProfesorPropuesto.Apellidos}"
                                        : "Por confirmar")
                                </p>
                            </div>

                            <div class="col-md-4">
                                <strong>Cancha</strong>

                                <p class="mb-0">
                                    @(Model.CanchaPropuesta?.Nombre ?? "Por confirmar")
                                </p>
                            </div>

                            <div class="col-md-8">
                                <strong>Observaciones de la academia</strong>

                                <p class="mb-0">
                                    @(string.IsNullOrWhiteSpace(Model.ObservacionesAcademia)
                                        ? "Sin observaciones adicionales."
                                        : Model.ObservacionesAcademia)
                                </p>
                            </div>

                        </div>

                    </div>
                }

                <div class="perfil-actions mt-4">

                    <a asp-controller="AdminSolicitudes"
                       asp-action="Index"
                       class="perfil-btn-outline">
                        Volver
                    </a>

                    @if (Model.Estado == "Pendiente" ||
                         Model.Estado == "En revisión")
                    {
                        <form asp-controller="AdminSolicitudes"
                              asp-action="Revisar"
                              method="post"
                              style="display:inline;">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.IdSolicitudCurso" />

                            <button type="submit"
                                    class="perfil-btn">

                                @(Model.Estado == "Pendiente"
                                    ? "Revisar solicitud"
                                    : "Continuar revisión")

                            </button>

                        </form>
                    }

                </div>

            </div>

        </div>

    </div>

</section>