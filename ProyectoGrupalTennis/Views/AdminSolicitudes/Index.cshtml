@using Microsoft.AspNetCore.Mvc.Rendering

@model List<AcademiaTennisDAL.Entities.SolicitudCurso>

@{
    ViewData["Title"] = "Gestionar solicitudes";

    var filtroIdAlumno =
        ViewBag.FiltroIdAlumno as string
        ?? string.Empty;

    var alumnos =
        ViewBag.Alumnos as SelectList
        ?? new SelectList(
            Enumerable.Empty<SelectListItem>());

    var filtroEstado =
        ViewBag.FiltroEstado as string
        ?? string.Empty;

    var filtroTipoClase =
        ViewBag.FiltroTipoClase as string
        ?? string.Empty;

    var filtroFecha =
        ViewBag.FiltroFecha as string
        ?? string.Empty;

    var estados =
        ViewBag.Estados as List<string>
        ?? new List<string>();

    var tiposClase =
        ViewBag.TiposClase as List<string>
        ?? new List<string>();

    var hayFiltros =
        !string.IsNullOrWhiteSpace(filtroIdAlumno) ||
        !string.IsNullOrWhiteSpace(filtroEstado) ||
        !string.IsNullOrWhiteSpace(filtroTipoClase) ||
        !string.IsNullOrWhiteSpace(filtroFecha);
}

<link rel="stylesheet"
      href="~/css/perfiles.css"
      asp-append-version="true" />

<section class="perfil-page compact">

    <div class="container-fluid px-4">

        <div class="perfil-container"
             style="max-width:1600px; margin:0 auto;">

            <div class="perfil-header">

                <div>

                    <h1 class="perfil-title">
                        Gestión de solicitudes
                    </h1>

                    <p class="perfil-subtitle">
                        Revisa las solicitudes enviadas por los alumnos y administra la asignación de horarios, profesores y canchas.
                    </p>

                </div>

                <div class="perfil-badge">
                    <i class="fa fa-calendar-check"></i>
                    Solicitudes
                </div>

            </div>

            <div class="perfil-table-block mb-4">

                <h2 class="perfil-table-title">
                    Filtrar solicitudes
                </h2>

                <p class="text-muted">
                    Puedes combinar varios filtros para encontrar solicitudes específicas.
                </p>

                <form asp-controller="AdminSolicitudes"
                      asp-action="Index"
                      method="get">

                    <div class="row g-3">

                        <div class="col-xl-3 col-lg-6 col-md-6">

                            <label for="idAlumno"
                                   class="form-label fw-bold">
                                Alumno
                            </label>

                            <select id="idAlumno"
                                    name="idAlumno"
                                    asp-items="alumnos"
                                    class="form-select">

                                <option value="">
                                    Todos los alumnos
                                </option>

                            </select>

                        </div>

                        <div class="col-xl-3 col-lg-6 col-md-6">

                            <label for="estado"
                                   class="form-label fw-bold">
                                Estado
                            </label>

                            <select id="estado"
                                    name="estado"
                                    class="form-select">

                                <option value="">
                                    Todos los estados
                                </option>

                                @foreach (var item in estados)
                                {
                                    if (filtroEstado == item)
                                    {
                                        <option value="@item"
                                                selected>
                                            @item
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@item">
                                            @item
                                        </option>
                                    }
                                }

                            </select>

                        </div>

                        <div class="col-xl-3 col-lg-6 col-md-6">

                            <label for="tipoClase"
                                   class="form-label fw-bold">
                                Tipo de clase
                            </label>

                            <select id="tipoClase"
                                    name="tipoClase"
                                    class="form-select">

                                <option value="">
                                    Todos los tipos
                                </option>

                                @foreach (var tipo in tiposClase)
                                {
                                    if (filtroTipoClase == tipo)
                                    {
                                        <option value="@tipo"
                                                selected>
                                            @tipo
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@tipo">
                                            @tipo
                                        </option>
                                    }
                                }

                            </select>

                        </div>

                        <div class="col-xl-3 col-lg-6 col-md-6">

                            <label for="fecha"
                                   class="form-label fw-bold">
                                Fecha de solicitud
                            </label>

                            <input type="date"
                                   id="fecha"
                                   name="fecha"
                                   value="@filtroFecha"
                                   class="form-control" />

                        </div>

                    </div>

                    <div style="
                        display:flex;
                        justify-content:flex-start;
                        align-items:center;
                        flex-wrap:wrap;
                        gap:14px;
                        margin-top:32px;
                        padding-left:0;">

                        <button type="submit"
                                class="perfil-btn">

                            <i class="fa fa-filter me-1"></i>
                            Filtrar

                        </button>

                        @if (hayFiltros)
                        {
                            <a asp-controller="AdminSolicitudes"
                               asp-action="Index"
                               class="perfil-btn-outline">

                                <i class="fa fa-rotate-left me-1"></i>
                                Limpiar filtros

                            </a>
                        }

                    </div>

                </form>

            </div>

            <div class="perfil-table-block">

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                    <div>

                        <h2 class="perfil-table-title mb-1">
                            Solicitudes registradas
                        </h2>

                        <p class="text-muted mb-0">
                            @Model.Count solicitud@(Model.Count == 1 ? "" : "es") encontrada@(Model.Count == 1 ? "" : "s").
                        </p>

                    </div>

                    @if (hayFiltros)
                    {
                        <span class="perfil-badge">
                            Resultados filtrados
                        </span>
                    }

                </div>

                <div class="table-responsive">

                    <table class="table table-striped mt-3">

                        <thead>
                            <tr>
                                <th>Solicitud</th>
                                <th>Alumno</th>
                                <th>Clase</th>
                                <th>Tipo</th>
                                <th>Nivel</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model.Any())
                            {
                                @foreach (var solicitud in Model)
                                {
                                    <tr>

                                        <td>
                                            SOL-@solicitud.IdSolicitudCurso.ToString("D4")
                                        </td>

                                        <td>
                                            @solicitud.Alumno.Nombre
                                            @solicitud.Alumno.Apellido
                                        </td>

                                        <td>
                                            @solicitud.NombreCurso
                                        </td>

                                        <td>
                                            @(string.IsNullOrWhiteSpace(solicitud.Modalidad)
                                                ? "Sin especificar"
                                                : solicitud.Modalidad)
                                        </td>

                                        <td>
                                            @solicitud.Nivel
                                        </td>

                                        <td>
                                            <span class="perfil-badge">
                                                @solicitud.Estado
                                            </span>
                                        </td>

                                        <td>
                                            @solicitud.FechaSolicitud.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>
                                            <a asp-controller="AdminSolicitudes"
                                               asp-action="Detalle"
                                               asp-route-id="@solicitud.IdSolicitudCurso"
                                               class="btn btn-success btn-sm">

                                                Ver detalle

                                            </a>
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>

                                    <td colspan="8"
                                        class="text-center py-5">

                                        <i class="fa fa-search mb-3"
                                           style="font-size:30px;">
                                        </i>

                                        <h3 class="mb-2">
                                            No encontramos solicitudes
                                        </h3>

                                        <p class="text-muted">
                                            No hay solicitudes que coincidan con los filtros seleccionados.
                                        </p>

                                        <a asp-controller="AdminSolicitudes"
                                           asp-action="Index"
                                           class="perfil-btn-outline">

                                            Ver todas las solicitudes

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</section>