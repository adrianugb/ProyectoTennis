@model IEnumerable<AcademiaTennisDAL.Entities.SolicitudCurso>

@{
    ViewData["Title"] = "Mis Solicitudes";
}

<link rel="stylesheet"
      href="~/css/perfiles.css"
      asp-append-version="true" />

<section class="perfil-page compact perfil-usuario-page">
    <div class="container">
        <div class="perfil-container">

            <div class="perfil-header">
                <div>
                    <h1 class="perfil-title">Mis Solicitudes de Clase</h1>

                    <p class="perfil-subtitle">
                        Consultá el estado de tus solicitudes y respondé las propuestas enviadas por la academia.
                    </p>
                </div>

                <div class="perfil-badge">
                    <i class="fa fa-file-alt"></i>
                    Solicitudes
                </div>
            </div>

            <div class="mb-4">
                <a asp-controller="Home"
                   asp-action="PerfilUsuario"
                   class="perfil-btn-outline">

                    <i class="fa fa-arrow-left"></i>
                    Volver al perfil
                </a>

                <a asp-controller="SolicitudesCurso"
                   asp-action="Catalogo"
                   class="perfil-btn">

                    <i class="fa fa-plus"></i>
                    Nueva solicitud
                </a>
            </div>

            @if (!Model.Any())
            {
                <div class="perfil-table-block text-center">

                    <i class="fa fa-inbox"
                       style="font-size:38px; color:#a5c422; margin-bottom:14px;">
                    </i>

                    <h3>No tienes solicitudes registradas</h3>

                    <p class="text-muted">
                        Explorá el catálogo y enviá tu primera solicitud de clase.
                    </p>

                    <a asp-controller="SolicitudesCurso"
                       asp-action="Catalogo"
                       class="perfil-btn">

                        Ver catálogo
                    </a>
                </div>
            }
            else
            {
                <div class="perfil-table-block">

                    <div class="table-responsive">
                        <table class="perfil-table">

                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Servicio solicitado</th>
                                    <th>Fecha</th>
                                    <th>Estado</th>
                                    <th>Propuesta</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var solicitud in Model)
                                {
                                    var claseEstado = solicitud.Estado switch
                                    {
                                        "Aceptada" => "perfil-badge-success",
                                        "Propuesta enviada" => "perfil-badge-warning",
                                        "En revisión" => "perfil-badge-warning",
                                        "Rechazada" => "perfil-badge-danger",
                                        "Cancelada" => "perfil-badge-danger",
                                        _ => "perfil-badge-warning"
                                    };

                                    <tr>
                                        <td>
                                            <strong>
                                                SOL-@solicitud.IdSolicitudCurso.ToString("D4")
                                            </strong>
                                        </td>

                                        <td>
                                            @solicitud.NombreCurso
                                        </td>

                                        <td>
                                            @solicitud.FechaSolicitud.ToString("dd/MM/yyyy")
                                        </td>

                                        <td>
                                            <span class="@claseEstado">
                                                @solicitud.Estado
                                            </span>
                                        </td>

                                        <td>
                                            @if (solicitud.FechaPropuesta.HasValue)
                                            {
                                                <div>
                                                    @solicitud.FechaPropuesta.Value.ToString("dd/MM/yyyy")
                                                </div>

                                                <small class="text-muted">
                                                    @solicitud.HoraInicioPropuesta?.ToString(@"hh\:mm")
                                                    -
                                                    @solicitud.HoraFinPropuesta?.ToString(@"hh\:mm")
                                                </small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Aún no enviada
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            @if (solicitud.Estado == "Propuesta enviada")
                                            {
                                                <a asp-controller="SolicitudesCurso"
                                                   asp-action="ResponderPropuesta"
                                                   asp-route-id="@solicitud.IdSolicitudCurso"
                                                   class="perfil-btn">

                                                    Responder propuesta
                                                </a>
                                            }
                                            else if (solicitud.FechaPropuesta.HasValue)
                                            {
                                                <a asp-controller="SolicitudesCurso"
                                                   asp-action="ResponderPropuesta"
                                                   asp-route-id="@solicitud.IdSolicitudCurso"
                                                   class="perfil-btn-outline">

                                                    Ver propuesta
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Sin acciones
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>
                </div>
            }

        </div>
    </div>
</section>