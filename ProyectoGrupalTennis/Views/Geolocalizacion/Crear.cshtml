@model AcademiaTennisDAL.Entities.ZonaCobertura

@{
    ViewData["Title"] = "Nueva Zona";
}

<link rel="stylesheet"
      href="~/css/perfiles.css"
      asp-append-version="true" />


<link rel="stylesheet"
      href="~/css/geolocalizacion.css"
      asp-append-version="true" />

<section class="perfil-page compact">
    <div class="container">

        <div class="perfil-container">

            <div class="perfil-header">
                <div>
                    <h1 class="perfil-title">
                        Nueva Zona de Cobertura
                    </h1>

                    <p class="perfil-subtitle">
                        Registre una zona y seleccione en el mapa el punto
                        desde donde se calculará el desplazamiento.
                    </p>
                </div>

                <div class="perfil-badge">
                    <i class="fa fa-map-marker"></i>
                    Geolocalización
                </div>
            </div>

            <div class="mb-4">
                <a asp-action="Index"
                   class="btn btn-outline-secondary btn-sm">

                    <i class="fa fa-arrow-left me-1"></i>
                    Volver
                </a>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <form asp-action="Crear"
                          method="post"
                          id="formZona">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombre"
                                       class="form-label">
                                    Nombre de la zona
                                </label>

                                <input asp-for="Nombre"
                                       class="form-control"
                                       placeholder="Ejemplo: San José Centro" />

                                <span asp-validation-for="Nombre"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="CostoAdicional"
                                       class="form-label">
                                    Costo adicional fijo
                                </label>

                                <input asp-for="CostoAdicional"
                                       class="form-control"
                                       type="number"
                                       min="0"
                                       step="0.01"
                                       placeholder="Ejemplo: 3000" />

                                <span asp-validation-for="CostoAdicional"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="RadioMaximoKm"
                                       class="form-label">
                                    Radio máximo de cobertura
                                </label>

                                <div class="input-group">
                                    <input asp-for="RadioMaximoKm"
                                           class="form-control"
                                           type="number"
                                           min="0.01"
                                           step="0.01"
                                           placeholder="Ejemplo: 20" />

                                    <span class="input-group-text">
                                        km
                                    </span>
                                </div>

                                <span asp-validation-for="RadioMaximoKm"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="TarifaPorKm"
                                       class="form-label">
                                    Tarifa por kilómetro
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        ₡
                                    </span>

                                    <input asp-for="TarifaPorKm"
                                           class="form-control"
                                           type="number"
                                           min="0"
                                           step="0.01"
                                           placeholder="Ejemplo: 500" />
                                </div>

                                <span asp-validation-for="TarifaPorKm"
                                      class="text-danger"></span>
                            </div>

                            <!-- Coordenadas ocultas -->
                            <input asp-for="LatitudCentro"
                                   type="hidden"
                                   id="LatitudCentro" />

                            <input asp-for="LongitudCentro"
                                   type="hidden"
                                   id="LongitudCentro" />

                            <div class="col-12 mb-3">

                                <label class="form-label fw-bold">
                                    Ubicación de referencia
                                </label>

                                <p class="mapa-instruccion mb-2">
                                    Haga clic sobre el mapa para colocar el marcador.
                                    También puede usar su ubicación actual.
                                </p>

                                <div class="d-flex gap-2 flex-wrap mb-3">

                                    <button type="button"
                                        id="btnMiUbicacion"
                                        class="geo-btn geo-btn-primary">

                                        <i class="fa fa-crosshairs me-1"></i>
                                        Usar mi ubicación actual
                                    </button>

                                    <button type="button"
                                        id="btnLimpiarUbicacion"
                                        class="geo-btn geo-btn-secondary">

                                        <i class="fa fa-eraser"></i>
                                        Limpiar selección
                                    </button>

                                </div>

                                <div id="mapaSede"
                                     class="mapa-geolocalizacion">
                                </div>

                                <div class="ubicacion-seleccionada mt-3">

                                    <div class="row">

                                        <div class="col-md-6 mb-2 mb-md-0">
                                            <small class="text-muted">
                                                Latitud seleccionada
                                            </small>

                                            <div id="textoLatitud"
                                                 class="fw-bold">
                                                No seleccionada
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <small class="text-muted">
                                                Longitud seleccionada
                                            </small>

                                            <div id="textoLongitud"
                                                 class="fw-bold">
                                                No seleccionada
                                            </div>
                                        </div>

                                    </div>

                                </div>

                                <div id="errorUbicacion"
                                     class="text-danger mt-2 d-none">

                                    Debe seleccionar una ubicación en el mapa.
                                </div>

                                <span asp-validation-for="LatitudCentro"
                                      class="text-danger"></span>

                                <span asp-validation-for="LongitudCentro"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-12 mt-2">
                                <div class="form-check">

                                    <input asp-for="Activa"
                                           class="form-check-input" />

                                    <label asp-for="Activa"
                                           class="form-check-label">
                                        Mantener esta zona activa
                                    </label>

                                </div>
                            </div>

                        </div>

                        <hr />

                        <div class="d-flex justify-content-end gap-2 flex-wrap">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancelar
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="fa fa-save me-1"></i>
                                Guardar zona
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</section>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>

    <script src="~/js/geolocalizacion-formulario.js"
            asp-append-version="true"></script>
}