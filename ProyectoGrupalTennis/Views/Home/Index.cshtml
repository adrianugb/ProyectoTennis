@{
    ViewData["Title"] = "Inicio";
}

<!-- HERO / SLIDER -->
<section id="inicio" class="hero-slider">
    <div class="hero-slide is-active" style="background-image:url('@Url.Content("~/images/slider1.jpg")')">
        <div class="hero-overlay"></div>
        <div class="container hero-content">
            <span class="hero-eyebrow">Academia de Tenis M.M.P.</span>
            <h1>Conocé nuestras clases</h1>
            <p>Elegí la clase que más te guste y disfrutá de una experiencia de entrenamiento profesional.</p>
            <div class="hero-actions">
                <a href="#clases" class="btn-hero btn-hero-solid smoothScroll">Ver nuestras clases</a>
            </div>
        </div>
    </div>

    <div class="hero-slide" style="background-image:url('@Url.Content("~/images/slider2.jpg")')">
        <div class="hero-overlay"></div>
        <div class="container hero-content">
            <span class="hero-eyebrow">Todo en un solo lugar</span>
            <h1>Gestioná tu academia de tenis</h1>
            <p>Clases, reservas, pagos y seguimiento de progreso, todo dentro del sistema.</p>
            <div class="hero-actions">
                <a asp-controller="Home" asp-action="Login" class="btn-hero btn-hero-solid">Iniciar sesión</a>
                <a asp-controller="Home" asp-action="Registro" class="btn-hero btn-hero-outline">Registrarse</a>
            </div>
        </div>
    </div>

    <div class="hero-slide" style="background-image:url('@Url.Content("~/images/slider3.jpg")')">
        <div class="hero-overlay"></div>
        <div class="container hero-content">
            <span class="hero-eyebrow">Rendimiento y seguimiento</span>
            <h1>Optimizá tu rendimiento</h1>
            <p>Profesores y alumnos conectados, con seguimiento del progreso técnico en tiempo real.</p>
            <div class="hero-actions">
                <a asp-controller="Home" asp-action="Registro" class="btn-hero btn-hero-solid">Crear cuenta</a>
            </div>
        </div>
    </div>

    <button class="hero-nav hero-prev" type="button" aria-label="Anterior"><i class="fa fa-chevron-left"></i></button>
    <button class="hero-nav hero-next" type="button" aria-label="Siguiente"><i class="fa fa-chevron-right"></i></button>

    <div class="hero-dots"></div>
</section>

<!-- SOBRE NOSOTROS -->
<section id="nosotros" class="section-pad section-white">
    <div class="container">
        @await Html.PartialAsync("~/Views/Shared/_AboutUs.cshtml")
    </div>
</section>

<!-- NUESTRAS CLASES -->
<section id="clases" class="section-pad section-tint">
    <div class="container">
        <div class="section-heading text-center reveal">
            <span class="section-eyebrow">Modalidades de entrenamiento</span>
            <h2 class="section-title">Nuestras Clases</h2>
            <p class="section-subtitle">
                Conocé nuestras modalidades de entrenamiento y elegí la que mejor se adapte a vos.
            </p>
        </div>

        <div class="classes-grid">

            <article class="class-card reveal">
                <div class="class-card-img">
                    <img src="~/images/clases-regulares.jpg" alt="Clases Regulares" loading="lazy" />
                </div>
                <div class="class-card-body">
                    <h3>Clases Regulares</h3>
                    <p>Clases semanales estructuradas para avanzar desde nivel básico hasta avanzado.</p>
                    <span class="class-meta"><i class="fa fa-clock-o"></i> 55 min • Matrícula anual requerida</span>
                    <a href="/Home/DetalleClaseRegular" class="class-link">Ver más información <i class="fa fa-arrow-right"></i></a>
                </div>
            </article>

            <article class="class-card reveal">
                <div class="class-card-img">
                    <img src="~/images/clases-esporadicas.jpg" alt="Clases Esporádicas" loading="lazy" />
                </div>
                <div class="class-card-body">
                    <h3>Clases Esporádicas</h3>
                    <p>Clases flexibles con reservación previa para entrenar cuando el alumno lo desee.</p>
                    <span class="class-meta"><i class="fa fa-clock-o"></i> 55 min • Sin matrícula anual</span>
                    <a href="/Home/DetalleClaseEsporadica" class="class-link">Ver más información <i class="fa fa-arrow-right"></i></a>
                </div>
            </article>

            <article class="class-card reveal">
                <div class="class-card-img">
                    <img src="~/images/curso-intensivo.jpg" alt="Curso Intensivo" loading="lazy" />
                </div>
                <div class="class-card-body">
                    <h3>Curso Intensivo</h3>
                    <p>Paquete de 10 lecciones en un máximo de 2 semanas, según el nivel del alumno.</p>
                    <span class="class-meta"><i class="fa fa-clock-o"></i> 10 sesiones • 55 min c/u</span>
                    <a href="/Home/DetalleCursoIntensivo" class="class-link">Ver más información <i class="fa fa-arrow-right"></i></a>
                </div>
            </article>

            <article class="class-card reveal">
                <div class="class-card-img">
                    <img src="~/images/clases-especificas.jpg" alt="Clases Específicas" loading="lazy" />
                </div>
                <div class="class-card-body">
                    <h3>Clases Específicas</h3>
                    <p>Entrenamientos enfocados en reforzar técnicas o mejorar un tema puntual.</p>
                    <span class="class-meta"><i class="fa fa-clock-o"></i> 55 min • Horarios a convenir</span>
                    <a href="/Home/DetalleClaseEspecifica" class="class-link">Ver más información <i class="fa fa-arrow-right"></i></a>
                </div>
            </article>

            <article class="class-card reveal">
                <div class="class-card-img">
                    <img src="~/images/clases-domicilio.jpg" alt="Clases a Domicilio" loading="lazy" />
                </div>
                <div class="class-card-body">
                    <h3>Clases a Domicilio</h3>
                    <p>Entrenamiento en la residencia del alumno si cuenta con cancha de tenis.</p>
                    <span class="class-meta"><i class="fa fa-clock-o"></i> 55 min • Sin matrícula anual</span>
                    <a href="/Home/DetalleClaseDomicilio" class="class-link">Ver más información <i class="fa fa-arrow-right"></i></a>
                </div>
            </article>

            <article class="class-card reveal">
                <div class="class-card-img">
                    <img src="~/images/paquete-empresarial.jpg" alt="Paquete Empresarial" loading="lazy" />
                </div>
                <div class="class-card-body">
                    <h3>Paquete Empresarial</h3>
                    <p>Planes personalizados para empresas interesadas en actividades para sus colaboradores.</p>
                    <span class="class-meta"><i class="fa fa-clock-o"></i> 55 min • Plan personalizado</span>
                    <a href="/Home/DetallePaqueteEmpresarial" class="class-link">Ver más información <i class="fa fa-arrow-right"></i></a>
                </div>
            </article>

        </div>
    </div>
</section>

<!-- TESTIMONIOS -->
<section id="opiniones" class="section-pad section-white">
    <div class="container">
        <div class="section-heading text-center reveal">
            <span class="section-eyebrow">Lo que dicen nuestros alumnos</span>
            <h2 class="section-title">Testimonios</h2>
        </div>

        <div class="reviews-grid">
            <div class="review-card reveal">
                <span class="review-stars">★★★★★</span>
                <p class="review-text">
                    Las clases me han ayudado muchísimo a mejorar mi técnica.
                    Los profesores explican muy bien y las lecciones son dinámicas.
                </p>
                <div class="review-user">
                    <strong>María González</strong>
                    <small>Clases Regulares</small>
                </div>
            </div>

            <div class="review-card reveal">
                <span class="review-stars">★★★★★</span>
                <p class="review-text">
                    Me encantó la flexibilidad de horarios.
                    Es ideal si no podés asistir siempre el mismo día.
                </p>
                <div class="review-user">
                    <strong>Carlos Espinoza</strong>
                    <small>Clases Esporádicas</small>
                </div>
            </div>

            <div class="review-card reveal">
                <span class="review-stars">★★★★★</span>
                <p class="review-text">
                    Excelente ambiente y profesores.
                    Se nota el seguimiento personalizado en cada clase.
                </p>
                <div class="review-user">
                    <strong>Ana López</strong>
                    <small>Curso Intensivo</small>
                </div>
            </div>
        </div>

        @*<div class="text-center mt-4 reveal">
            <a asp-controller="Home" asp-action="Campeonatos" class="btn-outline-tenis">
                <i class="fa fa-trophy"></i> Conocé nuestros campeonatos
            </a>
        </div>*@
    </div>
</section>

<!-- CTA: EMPEZAR / CONTACTO -->
<section id="contacto" class="section-pad section-dark">
    <div class="container">
        <div class="section-heading text-center reveal">
            <h2 class="section-title section-title-light">Empezá tu entrenamiento</h2>
            <p class="section-subtitle section-subtitle-light">
                Accedé al sistema o dejanos tu consulta sobre nuestras clases.
            </p>
        </div>

        <div class="cta-grid">
            <div class="cta-card reveal">
                <h3>Reservar clases</h3>
                <p>
                    Iniciá sesión o creá una cuenta para gestionar tus clases,
                    horarios y seguimiento dentro del sistema.
                </p>
                <div class="cta-actions">
                    <a asp-controller="Home" asp-action="Login" class="btn-hero btn-hero-solid">Iniciar sesión</a>
                    <a asp-controller="Home" asp-action="Registro" class="btn-hero btn-hero-outline">Crear cuenta</a>
                </div>
            </div>

            <div class="contact-card reveal">
                <h3>Contactanos</h3>
                <p>Dejanos tu consulta o escribinos directamente.</p>

                <form>
                    <div class="form-group">
                        <input type="text" class="form-control" placeholder="Nombre">
                    </div>
                    <div class="form-group">
                        <input type="email" class="form-control" placeholder="Correo electrónico">
                    </div>
                    <div class="form-group">
                        <textarea class="form-control" rows="3" placeholder="Escribí tu mensaje"></textarea>
                    </div>
                    <button type="button" class="btn-hero btn-hero-solid btn-block">Enviar consulta</button>
                </form>

                <div class="contact-divider"><span>o contactanos directamente</span></div>

                <div class="contact-alt-buttons">
                    <a href="mailto:info@academiatenis.com" class="btn-outline-tenis btn-sm-tenis">
                        <i class="fa fa-envelope"></i> Correo
                    </a>
                    <a href="https://wa.me/50683764752" target="_blank" rel="noopener" class="btn-whatsapp-tenis">
                        <i class="fab fa-whatsapp"></i> WhatsApp
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/rework-home.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/hero-slider.js"></script>
}