@model List<AcademiaTennisDAL.Entities.ProgresoAlumno>

@{
    ViewData["Title"] = "Historial de Evaluaciones";
}

<link rel="stylesheet"
      href="~/css/perfiles.css"
      asp-append-version="true" />
<link rel="stylesheet"
      href="~/css/progreso.css"
      asp-append-version="true" />

<section class="perfil-page compact progreso-page">
    <div class="container">
        <div class="perfil-container">

            <div class="perfil-header">
                <div>
                    <h1 class="perfil-title">
                        Historial de Evaluaciones
                    </h1>

                    <p class="perfil-subtitle">
                        Consulta las evaluaciones técnicas que has
                        registrado para tus alumnos.
                    </p>
                </div>

                <div class="perfil-badge">
                    <i class="fa fa-history"></i>
                    Historial
                </div>
            </div>

            <div class="mb-3">
                <a asp-controller="Progreso"
                   asp-action="ProfesorIndex"
                   class="btn-volver-progreso">

                    <i class="fa fa-arrow-left"></i>
                    Volver
                </a>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <form asp-controller="Progreso"
                          asp-action="ProfesorHistorial"
                          method="get">

                        <div class="row g-3 align-items-end">

                            <div class="col-md-5">
                                <label class="form-label">
                                    Buscar alumno
                                </label>

                                <input type="text"
                                       name="buscar"
                                       value="@ViewBag.Buscar"
                                       class="form-control"
                                       placeholder="Nombre o apellido" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">
                                    Curso
                                </label>

                                <select name="idCurso"
                                        asp-items="ViewBag.Cursos"
                                        class="form-select">

                                    <option value="">Todos los cursos</option>
                                </select>
                            </div>

                            <div class="col-md-3 d-flex gap-2">

                                <button type="submit"
                                        class="btn btn-primary">
                                    <i class="fa fa-search me-1"></i>
                                    Buscar
                                </button>

                                <a asp-controller="Progreso"
                                   asp-action="ProfesorHistorial"
                                   class="btn btn-outline-secondary">
                                    Limpiar
                                </a>

                            </div>

                        </div>

                    </form>

                </div>
            </div>

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info">
                    No se encontraron evaluaciones registradas.
                </div>
            }
            else
            {
                <div class="card shadow-sm">
                    <div class="card-body">

                        <div class="table-responsive">
                            <table class="table table-hover align-middle">

                                <thead>
                                    <tr>
                                        <th>Alumno</th>
                                        <th>Curso</th>
                                        <th>Fecha</th>
                                        <th>Nivel general</th>
                                        <th>Promedio</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var progreso in Model)
                                    {
                                        double promedio =
                                            (progreso.NivelSaque +
                                             progreso.NivelReves +
                                             progreso.NivelDerecha +
                                             progreso.NivelVolea +
                                             progreso.NivelMovimiento +
                                             progreso.NivelTactica) / 6.0;

                                        string claseNivel =
                                            progreso.NivelGeneral == "Avanzado"
                                                ? "badge-nivel-avanzado"
                                                : progreso.NivelGeneral == "Intermedio"
                                                    ? "badge-nivel-intermedio"
                                                    : "badge-nivel-principiante";
                                        <tr>
                                            <td>
                                                @progreso.Alumno?.Nombre
                                                @progreso.Alumno?.Apellido
                                            </td>

                                            <td>
                                                @(progreso.Curso?.Nombre
                                                    ?? "Sin curso")
                                            </td>

                                            <td>
                                                @(progreso.FechaEvaluacion.ToString("dd/MM/yyyy"))
                                            </td>

                                            <td>
                                                <span class="@claseNivel">
                                                    @progreso.NivelGeneral
                                                </span>
                                            </td>

                                            <td>
                                                @promedio.ToString("0.0") / 10
                                            </td>


                                            <td>
                                                <div class="d-flex gap-2">

                                                    <a asp-controller="Progreso"
                                                       asp-action="EditarProgreso"
                                                       asp-route-id="@progreso.IdProgreso"
                                                       class="btn btn-primary btn-sm">

                                                        <i class="fa fa-edit me-1"></i>
                                                        Editar
                                                    </a>

                                                    <form asp-controller="Progreso"
                                                          asp-action="EliminarProgreso"
                                                          asp-route-id="@progreso.IdProgreso"
                                                          method="post"
                                                          onsubmit="return confirm('¿Está seguro de eliminar esta evaluación?');">

                                                        @Html.AntiForgeryToken()

                                                        <button type="submit"
                                                                class="btn btn-danger btn-sm">

                                                            <i class="fa fa-trash me-1"></i>
                                                            Eliminar
                                                        </button>
                                                    </form>

                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                            </table>
                        </div>

                    </div>
                </div>
            }

        </div>
    </div>
</section>