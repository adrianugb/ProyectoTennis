@model ProyectoGrupalTennis.Models.NotificacionesUsuarioViewModel

@{
    var nombreCanal = Model.CanalPreferido switch
    {
        "Email" => "Correo electrónico",
        "Push" => "Notificación en la plataforma",
        _ => Model.CanalPreferido
    };

    var tiposActivos = new[]
    {
        Model.NotificacionesClase,
        Model.NotificacionesPago,
        Model.NotificacionesRecordatorio,
        Model.NotificacionesCampeonato
    }.Count(t => t);
}

<div class="module-block">
    <h1 class="module-title">Notificaciones - Alumno</h1>
    <p class="module-subtitle">
        Centro de notificaciones y preferencias de comunicación.
    </p>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success">@TempData["MensajeExito"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <script>
            function mostrarPanelAlumno(panel) {
                document.getElementById("panelPreferenciasAlumno").style.display = "none";
                document.getElementById("panelTiposAlumno").style.display = "none";

                if (panel === "preferencias") {
                    document.getElementById("panelPreferenciasAlumno").style.display = "block";
                } else if (panel === "tipos") {
                    document.getElementById("panelTiposAlumno").style.display = "block";
                }
            }

            function verDetalleAlumno(titulo, descripcion, estado) {
                document.getElementById("detalleTituloAlumno").innerText = titulo;
                document.getElementById("detalleDescripcionAlumno").innerText = descripcion;
                document.getElementById("detalleEstadoAlumno").innerText = estado;

                document.getElementById("modalDetalleAlumno").style.display = "flex";
            }

            function cerrarDetalleAlumno() {
                document.getElementById("modalDetalleAlumno").style.display = "none";
            }
    </script>

    <style>
            .modal-card-notificacion {
                background: #fff;
                max-width: 460px;
                width: 90%;
                padding: 26px 30px;
                border-radius: 16px;
                position: relative;
                box-shadow: 0 20px 45px rgba(0,0,0,.18);
            }

            /* ===== Notificaciones - Alumno: ajustes responsive ===== */
            .notif-acciones {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
                justify-content: center;
            }

                .notif-acciones form {
                    display: inline-block;
                    margin: 0;
                }

                .notif-acciones .module-btn {
                    white-space: nowrap;
                }

            @@media (max-width: 768px) {
                .module-block {
                    padding: 20px 16px;
                }

                .module-title {
                    font-size: 24px;
                }

                .module-subtitle {
                    margin-bottom: 20px;
                }

                .module-card {
                    min-height: unset;
                    padding: 20px 16px;
                }

                .modal-card-notificacion {
                    padding: 20px;
                }
                /* Tabla de notificaciones -> tarjetas apiladas en pantallas chicas */
                .table-responsive-cards table,
                .table-responsive-cards thead,
                .table-responsive-cards tbody,
                .table-responsive-cards th,
                .table-responsive-cards td,
                .table-responsive-cards tr {
                    display: block;
                    width: 100%;
                }

                .table-responsive-cards {
                    border-radius: 0;
                    overflow: visible;
                }

                    .table-responsive-cards thead tr {
                        position: absolute;
                        top: -9999px;
                        left: -9999px;
                    }

                    .table-responsive-cards tbody tr {
                        background: #fff;
                        border: 1px solid #ececec;
                        border-radius: 14px;
                        margin-bottom: 14px;
                        padding: 14px;
                        box-shadow: 0 4px 14px rgba(0,0,0,0.05);
                    }

                    .table-responsive-cards tbody td {
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        gap: 12px;
                        text-align: right;
                        padding: 8px 4px;
                        border-bottom: 1px solid #f5f5f5;
                    }

                        .table-responsive-cards tbody td:last-child {
                            border-bottom: none;
                        }

                        .table-responsive-cards tbody td::before {
                            content: attr(data-label);
                            font-weight: 700;
                            color: #252525;
                            text-align: left;
                            margin-right: 10px;
                            flex-shrink: 0;
                        }

                        .table-responsive-cards tbody td[data-label="Acción"] {
                            flex-direction: column;
                            align-items: stretch;
                            text-align: left;
                        }

                            .table-responsive-cards tbody td[data-label="Acción"]::before {
                                margin-bottom: 8px;
                            }

                .notif-acciones {
                    flex-direction: column;
                }

                    .notif-acciones .module-btn,
                    .notif-acciones form {
                        width: 100%;
                    }

                    .notif-acciones .module-btn {
                        width: 100%;
                        text-align: center;
                    }
            }
    </style>

    <div class="row">
        <div class="col-12 col-md-6">
            <div class="module-card" onclick="mostrarPanelAlumno('preferencias')" style="cursor:pointer;">
                <i class="fa fa-sliders"></i>
                <h3 style="user-select:none;">Preferencias</h3>
                <p>Canal principal: @nombreCanal</p>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="module-card" onclick="mostrarPanelAlumno('tipos')" style="cursor:pointer;">
                <i class="fa fa-envelope"></i>
                <h3 style="user-select:none;">Tipos de aviso</h3>
                <p>@tiposActivos de 4 tipos activos</p>
            </div>
        </div>
    </div>

    <!-- USER-09-008 y USER-09-009: un solo formulario guarda canal + tipos de aviso -->
    <form asp-controller="Usuario" asp-action="GuardarPreferenciasNotificacion" method="post">
        @Html.AntiForgeryToken()

        <div id="panelPreferenciasAlumno" style="display:none; margin-top: 30px;">
            <div class="module-card" style="text-align:left;">
                <h3>Configuración de preferencias</h3>

                <div class="row" style="margin-top: 15px;">
                    <div class="col-12 col-md-6">
                        <label>Canal principal</label>
                        <select asp-for="CanalPreferido" class="form-control">
                            <option value="Email">Correo electrónico</option>
                            <option value="Push">Notificación en la plataforma</option>
                        </select>
                        <small class="text-muted">
                            Por ahora el sistema solo envía avisos por correo electrónico o dentro de la plataforma.
                        </small>
                    </div>
                </div>

                <div class="module-actions" style="margin-top: 20px;">
                    <button type="submit" class="module-btn">Guardar preferencias</button>
                </div>
            </div>
        </div>

        <div id="panelTiposAlumno" style="display:none; margin-top: 30px;">
            <div class="module-card" style="text-align:left;">
                <h3>Tipos de aviso</h3>

                <div style="margin-top: 15px;">
                    <label style="display:block; margin-bottom: 10px;">
                        <input type="checkbox" asp-for="NotificacionesClase" /> Avisos de clases y matrículas
                    </label>
                    <label style="display:block; margin-bottom: 10px;">
                        <input type="checkbox" asp-for="NotificacionesPago" /> Avisos de pagos
                    </label>
                    <label style="display:block; margin-bottom: 10px;">
                        <input type="checkbox" asp-for="NotificacionesRecordatorio" /> Avisos de recordatorios de clase
                    </label>
                    <label style="display:block; margin-bottom: 10px;">
                        <input type="checkbox" asp-for="NotificacionesCampeonato" /> Avisos de campeonatos
                    </label>
                </div>

                <div class="module-actions" style="margin-top: 20px;">
                    <button type="submit" class="module-btn">Guardar tipos de aviso</button>
                </div>
            </div>
        </div>
    </form>

    <div class="table-responsive table-responsive-cards" style="margin-top: 25px;">
        <table class="table report-table">
            <thead>
                <tr>
                    <th>Notificación</th>
                    <th>Descripción</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th>Canal</th>
                    <th style="text-align:center;">Acción</th>
                </tr>
            </thead>

            <tbody>
                @if (Model == null || Model.Notificaciones == null || !Model.Notificaciones.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">
                            No tienes notificaciones registradas.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Notificaciones)
                    {
                        var estadoTexto = item.Leida ? "Leída" : "Nueva";

                        <tr class="@(item.Leida ? "" : "fw-bold")">
                            <td data-label="Notificación">@item.Titulo</td>
                            <td data-label="Descripción">@item.Mensaje</td>
                            <td data-label="Fecha">@item.FechaEnvio.ToString("dd/MM/yyyy HH:mm")</td>
                            <td data-label="Estado">
                                @if (item.Leida)
                                {
                                    <span class="badge-soft-success">Leída</span>
                                }
                                else
                                {
                                    <span class="badge-soft-warning">Nueva</span>
                                }
                            </td>
                            <td data-label="Canal">
                                @if (item.EnvioFallido)
                                {
                                    <span class="badge-soft-warning" title="No se pudo entregar por correo; disponible en la plataforma">
                                        <i class="fa fa-exclamation-triangle"></i> Correo falló · Plataforma
                                    </span>
                                }
                                else
                                {
                                    <span>@(item.CanalUsado == "Email" ? "Correo electrónico" : "Plataforma")</span>
                                }
                            </td>
                            <td data-label="Acción" style="text-align:center;">
                                <div class="notif-acciones">
                                    <button type="button"
                                            class="module-btn"
                                            onclick="verDetalleAlumno('@item.Titulo', '@item.Mensaje', '@estadoTexto')">
                                        Ver detalle
                                    </button>

                                    @if (!item.Leida)
                                    {
                                        <form asp-controller="Usuario"
                                              asp-action="MarcarNotificacionLeida"
                                              method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="idNotificacion" value="@item.IdNotificacion" />

                                            <button type="submit" class="module-btn">
                                                Marcar como leída
                                            </button>
                                        </form>
                                    }

                                    <form asp-controller="Usuario"
                                          asp-action="EliminarNotificacion"
                                          method="post"
                                          onsubmit="return confirm('¿Eliminar esta notificación?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idNotificacion" value="@item.IdNotificacion" />

                                        <button type="submit" class="module-btn" style="background:#c0392b;">
                                            Eliminar
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div id="modalDetalleAlumno"
         onclick="cerrarDetalleAlumno()"
         style="display:none;
        position:fixed;
        top:0;
        left:0;
        width:100%;
        height:100%;
        padding:20px;
        background:rgba(0,0,0,.45);
        z-index:9999;
        align-items:center;
        justify-content:center;">

        <div class="modal-card-notificacion"
             onclick="event.stopPropagation();">

            <button type="button"
                    onclick="cerrarDetalleAlumno()"
                    style="position:absolute; top:12px; right:14px; border:none; background:transparent; font-size:22px;">
                ×
            </button>

            <h3 id="detalleTituloAlumno" style="text-align:center; margin-bottom:18px;">
                Detalle de notificación
            </h3>

            <p style="margin-bottom:14px;">
                <strong>Descripción:</strong><br />
                <span id="detalleDescripcionAlumno"></span>
            </p>

            <p style="margin-bottom:18px;">
                <strong>Estado:</strong>
                <span id="detalleEstadoAlumno"></span>
            </p>

            <div style="text-align:right;">
                <button type="button"
                        class="module-btn"
                        onclick="cerrarDetalleAlumno()">
                    Cerrar
                </button>
            </div>

        </div>
    </div>
</div>