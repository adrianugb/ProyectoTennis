@{
    ViewData["Title"] = "Perfil del Profesor";
}

<link rel="stylesheet" href="~/css/perfiles.css" asp-append-version="true" />

<section class="perfil-page compact">
    <div class="container-xxl">
        <div class="perfil-container">

            <div class="perfil-header">
                <div>
                    <h1 class="perfil-title">Panel del Profesor</h1>
                    <p class="perfil-subtitle">
                        Consulta tus cursos asignados y visualiza la información relevante de tus alumnos.
                    </p>
                </div>
                <div class="perfil-badge">
                    <i class="fa fa-user"></i> Perfil Profesor
                </div>
            </div>
            @if (ViewBag.TieneGoogleCalendar == true)
            {
                <span class="perfil-badge-success">
                    <i class="fa fa-calendar"></i> Google Calendar conectado
                </span>
                <a asp-controller="GoogleCalendar" asp-action="Desconectar"
                   class="perfil-btn-outline">Desconectar</a>
            }
            else
            {
                <a asp-controller="GoogleCalendar" asp-action="Autorizar"
                   asp-route-returnUrl="@Context.Request.Path"
                   class="perfil-btn">
                    <i class="fa fa-calendar"></i> Conectar Google Calendar
                </a>
            }

            <div class="perfil-grid">
                <div class="row">

                    <div class="col-12 col-md-6 col-xxl-3">
                        <div class="perfil-card">
                            <i class="fa fa-book"></i>
                            <h3>Mis Cursos</h3>
                            <p>
                                Visualiza el catálogo de cursos asignados, niveles y horarios disponibles para impartir.
                            </p>
                            <div class="perfil-actions">
                                <a asp-controller="PerfilProfesor" asp-action="MisCursos" class="perfil-btn">
                                    Ver cursos
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xxl-3">
                        <div class="perfil-card">
                            <i class="fa fa-users"></i>
                            <h3>Mis Alumnos</h3>
                            <p>
                                Consulta la información de tus estudiantes y revisa detalles relevantes para el seguimiento.
                            </p>
                            <div class="perfil-actions">
                                <a asp-controller="PerfilProfesor" asp-action="MisAlumnos" class="perfil-btn">
                                    Ver alumnos
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xxl-3">
                        <div class="perfil-card">
                            <i class="fa fa-table-tennis"></i>
                            <h3>Reservar Cancha</h3>
                            <p>
                                Reserva una cancha para impartir clases particulares a tus alumnos.
                            </p>
                            <div class="perfil-actions">
                                <a asp-controller="Reservas" asp-action="Reservar" class="perfil-btn">
                                    Crear reserva
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xxl-3">
                        <div class="perfil-card">
                            <i class="fa fa-calendar"></i>
                            <h3>Mis Reservas</h3>
                            <p>
                                Consulta las reservas creadas y verifica si ya fueron asignadas a un alumno.
                            </p>
                            <div class="perfil-actions">
                                <a asp-controller="Reservas" asp-action="MisReservas" class="perfil-btn">
                                    Ver reservas
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xxl-3">
                        <div class="perfil-card">
                            <i class="fa fa-bell"></i>
                            <h3>Notificaciones</h3>
                            <p>
                                Revisá los avisos sobre cursos asignados, cambios de horario y recordatorios de clase.
                            </p>
                            <div class="perfil-actions">
                                <a asp-controller="PerfilProfesor" asp-action="Notificaciones" class="perfil-btn">
                                    Ver notificaciones
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xxl-3">
                        <div class="perfil-card">
                            <i class="fa fa-bullhorn"></i>
                            <h3>Progreso Técnico</h3>
                            <p>
                                Registra evaluaciones y consulta el progreso
                                técnico de tus alumnos.
                            </p>
                            <div class="perfil-actions">
                                <a asp-controller="Progreso" asp-action="ProfesorIndex" class="perfil-btn">
                                    Ver Progreso
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-xxl-3">
                        <div class="perfil-card">
                            <i class="fa fa-bullhorn"></i>

                            <h3>Clases a Domicilio</h3>

                            <p>
                                Consulta las ubicaciones de tus alumnos y abre
                                la ruta mediante Google Maps o Waze.
                            </p>

                            <div class="perfil-actions">
                                <a asp-controller="Geolocalizacion"
                                   asp-action="ClasesDomicilioProfesor"
                                   class="perfil-btn">

                                    Ver ubicaciones
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
