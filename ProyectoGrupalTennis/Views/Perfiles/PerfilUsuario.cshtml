@{
    ViewData["Title"] = "Perfil de Usuario";
}

<link rel="stylesheet" href="~/css/perfiles.css" asp-append-version="true" />

<section class="perfil-page compact perfil-usuario-page">
    <div class="container-xxl">
        <div class="perfil-container">

            <div class="perfil-header">
                <div>
                    <h1 class="perfil-title">Panel de Usuario</h1>
                    <p class="perfil-subtitle">
                        Accedé a tus cursos, horarios, pagos y más desde un solo lugar.
                    </p>
                </div>
                <div class="perfil-badge">
                    <i class="fa fa-user"></i> Perfil Usuario
                </div>
            </div>
            @if (ViewBag.TieneGoogleCalendar == true)
            {
                <span class="perfil-badge-success">
                    <i class="fa fa-calendar"></i> Google Calendar conectado
                </span>
                <a asp-controller="GoogleCalendar" asp-action="Desconectar"
                   class="perfil-btn-outline">Desconectar</a>
            }
            else
            {
                <a asp-controller="GoogleCalendar" asp-action="Autorizar"
                   asp-route-returnUrl="@Context.Request.Path"
                   class="perfil-btn">
                    <i class="fa fa-calendar"></i> Conectar Google Calendar
                </a>
            }

            <nav class="perfil-usuario-nav">
                <a href="#gestion-academica">
                    <i class="fa fa-graduation-cap"></i>
                    Gestión académica
                </a>

                <a href="#mi-cuenta">
                    <i class="fa fa-user-cog"></i>
                    Mi cuenta
                </a>

                <a href="#servicios">
                    <i class="fa fa-star"></i>
                    Servicios
                </a>
            </nav>
            <div id="gestion-academica"
                 class="perfil-usuario-section">

                <h2>
                    <i class="fa fa-graduation-cap"></i>
                    Gestión académica
                </h2>

                <p>
                    Consultá tus clases, solicitudes y opciones disponibles.
                </p>

            </div>

            <div class="row g-4">

                <!-- Mi Agenda -->
                <div class="col-12 col-md-6 col-xxl-3">
                    <div class="perfil-card">
                        <i class="fa fa-calendar-alt"></i>

                        <h3>Mi Agenda</h3>

                        <p>
                            Consultá tus clases confirmadas, horarios y próximas sesiones.
                        </p>

                        <div class="perfil-actions">
                            <a asp-controller="Usuario"
                               asp-action="AgendaPersonal"
                               class="perfil-btn">

                                <i class="fa fa-calendar-check"></i>
                                Ver Agenda
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Mis Solicitudes -->
                <div class="col-12 col-md-6 col-xxl-3">
                    <div class="perfil-card">
                        <i class="fa fa-file-alt"></i>

                        <h3>Mis Solicitudes de Clase</h3>

                        <p>
                            Da seguimiento a tus solicitudes y respondé las propuestas de la academia.
                        </p>

                        <div class="perfil-actions">
                            <a asp-controller="SolicitudesCurso"
                               asp-action="MisSolicitudes"
                               class="perfil-btn">

                                <i class="fa fa-list-alt"></i>
                                Ver Solicitudes
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Catálogo -->
                <div class="col-12 col-md-6 col-xxl-3">
                    <div class="perfil-card">
                        <i class="fa fa-book-open"></i>

                        <h3>Catálogo de Clases</h3>

                        <p>
                            Explorá modalidades, niveles, paquetes y servicios disponibles.
                        </p>

                        <div class="perfil-actions">
                            <a asp-controller="SolicitudesCurso"
                               asp-action="Catalogo"
                               class="perfil-btn">

                                <i class="fa fa-search"></i>
                                Ver Catálogo
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Matrícula -->
                <div class="col-12 col-md-6 col-xxl-3">
                    <div class="perfil-card">
                        <i class="fa fa-file-signature"></i>

                        <h3>Matrícula</h3>

                        <p>
                            Consultá las clases programadas por la academia y matriculate cuando exista disponibilidad.
                        </p>

                        <div class="perfil-actions">
                            <a asp-controller="Usuario"
                               asp-action="MisCursos"
                               class="perfil-btn">

                                <i class="fa fa-user-plus"></i>
                                Ver Matrícula
                            </a>
                        </div>
                    </div>
                </div>

            </div>


            <!-- =====================================================
         SECCIÓN 2: CUENTA Y COMUNICACIÓN
    ====================================================== -->

            <div id="mi-cuenta"
                 class="perfil-usuario-section">

                <h2>
                    <i class="fa fa-user-cog"></i>
                    Mi cuenta
                </h2>

                <p>
                    Administrá tus pagos, notificaciones y seguridad.
                </p>

            </div>

            <div class="row g-4">

                <!-- Pagos -->
                <div class="col-12 col-md-6 col-xxl-3">
                    <div class="perfil-card">
                        <i class="fa fa-wallet"></i>

                        <h3>Pagos</h3>

                        <p>
                            Consultá el estado de tus pagos, facturas y recibos.
                        </p>

                        <div class="perfil-actions">
                            <a asp-controller="Home"
                               asp-action="UsuarioPagos"
                               class="perfil-btn">

                                <i class="fa fa-receipt"></i>
                                Ver Pagos
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Notificaciones -->
                <div class="col-12 col-md-6 col-xxl-3">
                    <div class="perfil-card">
                        <i class="fa fa-bell"></i>

                        <h3>Notificaciones</h3>

                        <p>
                            Revisá mensajes, propuestas y avisos recientes de la academia.
                        </p>

                        <div class="perfil-actions">
                            <a asp-controller="Usuario"
                               asp-action="Notificaciones"
                               class="perfil-btn">

                                <i class="fa fa-envelope"></i>
                                Ver Notificaciones
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Seguridad -->
                <div class="col-12 col-md-6 col-xxl-3">
                    <div class="perfil-card">
                        <i class="fa fa-shield-alt"></i>

                        <h3>Seguridad</h3>

                        <p>
                            Actualizá tu contraseña para mantener protegida tu cuenta.
                        </p>

                        <div class="perfil-actions">
                            <a asp-controller="Auth"
                               asp-action="CambiarPassword"
                               class="perfil-btn">

                                <i class="fa fa-key"></i>
                                Cambiar Contraseña
                            </a>
                        </div>
                    </div>
                </div>

            </div>


            <!-- =====================================================
         SECCIÓN 3: EXPERIENCIA Y SERVICIOS
    ====================================================== -->

            <div id="servicios"
                 class="perfil-usuario-section">

                <h2>
                    <i class="fa fa-star"></i>
                    Experiencia y servicios
                </h2>

                <p>
                    Accedé a tu progreso, actividades y servicios adicionales.
                </p>

            </div>

            
            <div class="row g-4">

                <!-- Progreso Técnico -->
                <div class="col-12 col-md-6 col-xxl-3">
                    <div class="perfil-card">
                        <i class="fa fa-chart-line"></i>

                        <h3>Progreso Técnico</h3>

                        <p>
                            Consultá tus evaluaciones, nivel actual y áreas de mejora.
                        </p>

                        <div class="perfil-actions">
                            <a asp-controller="Progreso"
                               asp-action="AlumnoIndex"
                               class="perfil-btn">

                                <i class="fa fa-chart-bar"></i>
                                Ver Progreso
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Campeonatos -->
                <div class="col-12 col-md-6 col-xxl-3">
                    <div class="perfil-card">
                        <i class="fa fa-trophy"></i>

                        <h3>Campeonatos</h3>

                        <p>
                            Consultá torneos disponibles e inscribite como jugador.
                        </p>

                        <div class="perfil-actions">
                            <a asp-controller="Home"
                               asp-action="Campeonatos"
                               class="perfil-btn">

                                <i class="fa fa-medal"></i>
                                Ver Campeonatos
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Mi Ubicación -->
                <div class="col-12 col-md-6 col-xxl-3">
                    <div class="perfil-card">
                        <i class="fa fa-map-marker-alt"></i>

                        <h3>Mi Ubicación</h3>

                        <p>
                            Registrá o actualizá tu ubicación para solicitar clases a domicilio.
                        </p>

                        <div class="perfil-actions">
                            <a asp-controller="Geolocalizacion"
                               asp-action="IndexAlumno"
                               class="perfil-btn">

                                <i class="fa fa-location-arrow"></i>
                                Gestionar Ubicación
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Soporte -->
                <div class="col-12 col-md-6 col-xxl-3">
                    <div class="perfil-card">
                        <i class="fa fa-headset"></i>

                        <h3>Soporte</h3>

                        <p>
                            ¿Necesitás ayuda? Contactá al equipo de la academia.
                        </p>

                        <div class="perfil-actions">
                            <a href="/#google-map"
                               class="perfil-btn">

                                <i class="fa fa-comments"></i>
                                Contactar
                            </a>
                        </div>
                    </div>
                </div>

            </div>



        @*                 Seccion 4 - Extra y evaluar si se necesita
 *@

        @*  No se si deberia estar - No lo quito pero lo comento
                <div class="col-12 col-md-6 col-xxl-3">
                    <div class="perfil-card">
                        <i class="fa fa-clock"></i>
                        <h3>Horarios Disponibles</h3>
                        <p>Consultá los horarios de los cursos activos y filtrá por día.</p>
                        <div class="perfil-actions">
                            <a asp-controller="Usuario" asp-action="MisHorarios" class="perfil-btn">
                                Ver Horarios
                            </a>
                        </div>
                    </div>
                </div>
 *@
                 

        @*   Aun esto se necesta?

                    <div class="col-12 col-md-6 col-xxl-3">
                        <div class="perfil-card">
                            <i class="fa fa-table-tennis"></i>
                            <h3>Reservar Cancha</h3>
                            <p>
                                Consultá las reservas creadas por los profesores y reservá tu espacio.
                            </p>

                            <div class="perfil-actions">
                                <a asp-controller="Reservas"
                                   asp-action="Disponibles"
                                   class="perfil-btn">
                                    Ver Disponibles
                                </a>
                            </div>
                        </div>
                    </div> *@

        @*        Nota: La academia tiene si acaso dos canchas, no permite reservar una cancha (hay que reservar una clase/paquete) pero si da visibilidad de la cancha asignada.

                    <div class="col-12 col-md-6 col-xxl-3">
                        <div class="perfil-card">
                            <i class="fa fa-calendar-check"></i>
                            <h3>Mis Reservas</h3>
                            <p>
                                Revisá las reservas de cancha que tienes asignadas.
                            </p>

                            <div class="perfil-actions">
                                <a asp-controller="Reservas"
                                   asp-action="MisReservasAlumno"
                                   class="perfil-btn">
                                    Ver Reservas
                                </a>
                            </div>
                        </div>
                    </div> *@

               

                   
    </div>
</div>

</div>

</section>